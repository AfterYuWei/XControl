{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-core",
  "description": "Android/iOS 共用核心能力；不授予窗口、drag-out、updater、process 或任意桌面文件系统权限。",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "deep-link:default",
    "system-insets:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
